# Nova WhatsApp bot — systemd unit. Install: /etc/systemd/system/nova.service
# Node 20+ זהו שירות בלי תלויות (אין npm install). הנתונים ב-/var/lib/nova (DATA_DIR), הסודות ב-/etc/nova/nova.env.
[Unit]
Description=Nova WhatsApp bot (127.0.0.1:${PORT})
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=nova
Group=nova
EnvironmentFile=/etc/nova/nova.env
WorkingDirectory=/opt/nova/bot
ExecStart=/usr/bin/env node /opt/nova/bot/src/server.js
Restart=always
RestartSec=3
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nova
ProtectHome=read-only
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
